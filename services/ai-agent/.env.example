# --- HTTP ---
PORT=8787
HOST=0.0.0.0

# --- LLM ---
# "mock"      -> deterministic offline rules, no API key needed (great for demos/tests)
# "anthropic" -> real Claude API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1500
ANTHROPIC_TIMEOUT_MS=45000
# What happens when the real LLM is unavailable: "mock" keeps the app usable,
# "off" surfaces the failure to the app as HTTP 502.
LLM_FALLBACK=mock

# --- Existing delivery API (your backend) ---
# When set, the service proxies reads/writes to your real API.
# When empty, a built-in demo dataset is used so the app runs out of the box.
EXISTING_API_BASE_URL=
EXISTING_API_KEY=

# --- Authentication ---
# Legacy service-to-service secret (alternative to a user session token).
DRIVER_API_TOKEN=
SESSION_TTL_HOURS=12
# First-run users. Passwords MUST be set here (or they are generated once and
# printed to the server console at first boot). Never commit real credentials.
SEED_DRIVER_ID=DRV-77
SEED_DRIVER_EMAIL=driver@fleet.local
SEED_DRIVER_PASSWORD=
SEED_ADMIN_ID=ADM-01
SEED_ADMIN_EMAIL=admin@fleet.local
SEED_ADMIN_PASSWORD=

# --- Persistence ---
# SQLite file (relative to services/ai-agent). Delete it to reset demo data.
DATABASE_PATH=data/delivery.db

# --- Guardrails ---
MAX_AGENT_TURNS=6
MAX_MESSAGE_CHARS=320
MIN_MESSAGE_CHARS=40
